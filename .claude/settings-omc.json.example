{
  "_comment": "OMC 전환 후 settings.json 예시. 본 파일은 참고용이며 실제 swap은 운영 검증 통과 후 사용자 결정. 자세한 사항은 docs/migration-omc-mapping-20260522.md 3·6절 참조.",
  "_omc_migration_notes": {
    "removed_hooks_with_reason": {
      "shared-context-cleanup (SessionStart)": "OMC notepad_prune / state_clear가 session-scoped 자동 정리 제공",
      "shared-context-inject (SubagentStart)": "에이전트가 mcp__plugin_oh-my-claudecode_t__notepad_read / shared_memory_read 직접 호출",
      "shared-context-collect (SubagentStop)": "에이전트가 notepad_write_* / shared_memory_write 직접 호출",
      "shared-context-finalize (SessionEnd)": "OMC state_write 또는 wiki_add로 대체",
      "subagent-monitor (SubagentStop)": "OMC trace_summary / trace_timeline이 동등 기능 제공",
      "notify-telegram (SubagentStop)": "글로벌 ~/.claude/settings.json의 telegram plugin이 처리",
      "task-quality-gate (TaskCompleted)": "Agent(verifier) 또는 /oh-my-claudecode:verify 명시적 호출로 대체",
      "teammate-idle-check (TeammateIdle)": "OMC team / omc-teams 워크플로의 내장 idle 감지",
      "enforce-delegation (PreToolUse Edit|Write)": "위임 강제 시스템 자체를 옵션 A로 제거함 (글로벌 권고만 유지)"
    },
    "verification_before_swap": [
      "OMC notepad TTL이 shared-context-config.json과 호환되는지 확인",
      "글로벌 telegram plugin이 SubagentStop을 실제로 받는지 알림 테스트",
      "task-quality-gate 자동 트리거가 사라진 후 verifier 명시 호출로 동등한 검증 강도가 유지되는지 운영 검증",
      "OMC team의 TeammateIdle 이벤트 내장 처리 확인"
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/statusline.sh",
    "padding": 1
  },
  "hooks": {}
}
